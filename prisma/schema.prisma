generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
  schemas  = ["sk_bills"]
}

// recurrence stores the RecurrenceRule as a JSON string (SQL Server has no native JSON column type).
model Bill {
  id          String   @id @default(cuid())
  store       String
  vendor      String
  category    String
  recurrence  String
  amountType  String
  amountValue Float
  payment     String
  account     String?
  paidFrom    String?
  anchor      String?
  end         String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([store])
  @@index([active])
  @@schema("sk_bills")
}

model BillPayment {
  id      String   @id @default(cuid())
  billId  String
  dueDate String
  paidAt  DateTime @default(now())

  @@unique([billId, dueDate])
  @@index([billId])
  @@schema("sk_bills")
}

model Sales {
  store     String
  ym        String
  projected Float?
  actual    Float?
  updatedAt DateTime @updatedAt

  @@id([store, ym])
  @@schema("sk_bills")
}

model QbToken {
  company      String   @id
  realmId      String
  accessToken  String   @db.NVarChar(Max)
  refreshToken String   @db.NVarChar(Max)
  expiresAt    BigInt
  updatedAt    DateTime @updatedAt

  @@schema("sk_bills")
}

// One row (id=1, enforced by a CHECK constraint — this is a single shared
// OpenBudget/Plaid connection, not per-store like QbToken). clientId is the
// app's OWN dynamically-registered OAuth client
// (iBDYVZjLmwWUsskkBJSxdYGQwuSOuUFy, public/PKCE, no secret) — deliberately
// NOT the client Claude Code registers for itself, so the app's token
// lifecycle is independent of any CLI session.
// Table is created idempotently at runtime (see openbudget.ts), same
// convention as QbBalance below — this model exists so `prisma db push`
// recognizes it and does not try to drop it.
model OpenBudgetToken {
  id           Int      @id @default(1)
  clientId     String   @db.NVarChar(64)
  accessToken  String   @db.NVarChar(Max)
  refreshToken String   @db.NVarChar(Max)
  expiresAt    BigInt
  scope        String?  @db.NVarChar(400)
  updatedAt    DateTime @default(now())

  @@schema("sk_bills")
}

// Mirrors the table created at runtime by /api/sync (the daily QB balance cron).
// Declared here so `prisma db push` recognizes it and does not try to drop it.
model QbBalance {
  store      String   @id @db.NVarChar(20)
  checking   Float    @default(0)
  savings    Float    @default(0)
  petty      Float    @default(0)
  creditCard Float    @default(0)
  cashTotal  Float    @default(0)
  updatedAt  DateTime @default(now())

  @@schema("sk_bills")
}

// Per-store daily cash-forecast ledger, written by the local forecast.py job and
// read by the /cashflow dashboard view. Declared so `prisma db push` won't drop it.
model Forecast {
  store     String    @db.NVarChar(20)
  d         DateTime  @db.Date
  inflow    Float?
  outflow   Float?
  balance   Float?
  asOf      DateTime? @map("as_of") @db.Date
  balSrc    String?   @map("bal_src") @db.NVarChar(24)
  stale     Boolean?
  updatedAt DateTime  @default(now())

  @@id([store, d])
  @@schema("sk_bills")
}

// Per-store WEEKLY cost plan (accrual view), written by the local cost_plan.py job.
// One row per store/week/metric; each amount split actual/committed/forecast.
// metric in: sales, cogs_pfg, cogs_walmart, labor, corporate, fixed. Declared so
// `prisma db push` won't drop it.
model CostPlan {
  store     String    @db.NVarChar(20)
  weekStart DateTime  @map("week_start") @db.Date
  metric    String    @db.NVarChar(24)
  actual    Float?
  committed Float?
  forecast  Float?
  asOf      DateTime? @map("as_of") @db.Date
  updatedAt DateTime  @default(now())

  @@id([store, weekStart, metric])
  @@schema("sk_bills")
}

// A linked bank/card account from the OpenBudget (Plaid) feed, tied to the store
// that owns it. Reconciliation needs this because the same merchant (FPL, Comcast,
// Smoothie King Corporate) bills all three stores — the account is what says which.
// Cards are store-specific too (confirmed against the QuickBooks chart of accounts),
// despite the feed naming them identically. `store` is null only when an account
// is not on any store's books, and such an account can settle no bills.
model BankAccount {
  id          String   @id @db.NVarChar(32) // OpenBudget id, e.g. "ACT-000002"
  institution String   @db.NVarChar(64)
  name        String   @db.NVarChar(128)
  subtype     String   @db.NVarChar(32)     // checking | savings | credit card
  mask        String?  @db.NVarChar(8)
  store       String?  @db.NVarChar(20)     // Margate | Pines | Miramar | null = unattributed
  paidFrom    String?  @db.NVarChar(32)     // matches Bill.paidFrom labels (BOA, Chase, ...)
  storeNumber String?  @db.NVarChar(8)      // SK store #, appears as "ID:1392" in ACH descriptors
  active      Boolean  @default(true)
  updatedAt   DateTime @default(now())

  @@index([store])
  @@schema("sk_bills")
}

// Maps a bank descriptor to the Bill it pays.
//
// Necessary because bills arrive under ACH originator names that share no words
// with the vendor label — "SKFI OPERATING DES:P4_ROYALTY" is the royalty fee,
// "MECHANICS&FARMER DES:AUTO TRANS" is M&F Bank. Fuzzy name matching scores ~0
// on these, so the mapping is stated explicitly rather than guessed.
//
// Resolution order: highest priority wins, then longest pattern. The rule's store
// must equal the paying account's store — each store keeps its own bills and
// vendors, so cross-store matching is never valid.
model VendorAlias {
  id        String   @id @default(cuid())
  pattern   String   @db.NVarChar(200)     // compared case-insensitively
  matchType String   @default("contains") @db.NVarChar(16) // contains | prefix | regex
  field     String   @default("name") @db.NVarChar(16)     // name (raw descriptor) | merchant
  store     String?  @db.NVarChar(20)      // must equal the paying account's store
  amountMin Float?                          // absolute dollars, inclusive
  amountMax Float?
  billId    String   @db.NVarChar(64)
  // Some vendors settle several of a store's bills in one charge — Neal Realty
  // bills Margate base rent and CAM as a single draft, and Lockton bills two
  // policies together. Comma-separated Bill ids settled alongside billId, so a
  // consumer can close every occurrence the payment covers instead of just one.
  alsoSettles String? @db.NVarChar(400)
  // The bill's amountValue is a placeholder, not an expectation — credit-card
  // bills are paid at whatever the balance allows. Suppresses over/under-payment
  // reporting, which would otherwise flag every one of them.
  variableAmount Boolean @default(false)
  // Comma-separated day numbers (0=Sun..6=Sat). Some vendors bill a store several
  // times a week as separate bills — PFG delivers on set days, and the delivery
  // day is the only thing distinguishing "Mon order" from "Tue order".
  weekday   String?  @db.NVarChar(20)
  priority  Int      @default(0)
  confirmed Boolean  @default(false)        // false = proposed from history, needs review
  note      String?  @db.NVarChar(400)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([billId])
  @@index([enabled])
  @@schema("sk_bills")
}
